# 忽略编译生成的中间文件
*.o
*.ko
*.mod
*.mod.c
*.order
*.symvers
*.cmd
.tmp_versions/
*.lds
*.usyms

# 忽略 VS Code 配置
.vscode/
.claude/
.codex/
# android build outputs
android/obj/
android/libomp.a
android/libomp.so
obj/
/libs/
windows/__pycache__/
*.pyc
**/.pyinstaller/

# Build dependency files
*.o.d
*.d

# VS Code settings in subdirectories
**/.vscode/

# Local ARM64 decoder and executor tests
lsdriver/arm64_tests/*
!lsdriver/arm64_tests/arm64_page_reloc_test.c
!lsdriver/arm64_tests/arm64_encode_test.c
!lsdriver/arm64_tests/run_tests.sh


# Android Studio / Gradle / NDK outputs
.gradle/
.idea/
*.iml
local.properties
build/
out/
captures/
.cxx/
.externalNativeBuild/

# Common generated archives and packages
*.apk
*.aab
*.aar

# Windows precompiled executables (PyInstaller / go build artifacts)
# LuckyStar.exe, LuckyStarMcp.exe 由 windows/build_executables.py 打包生成
# go_client/LuckyStar.exe 由 windows/go_client/build.ps1 (go build) 生成
windows/*.exe
windows/go_client/*.exe

# Common OS junk
.DS_Store
Thumbs.db

# android root-level binaries
android/*.a
android/*.so

# Generated driver installer (packer.sh embeds base64 .ko into this script)
install_driver.sh

# Downloaded cloudflared payload embedded into LS_KTool at build time
android/jni/assets/cloudflared-linux-arm64
